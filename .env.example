# OpenCode Go 구독 (기본)
# Account → Personal API keys에서 복사한 키 전체 (oc_sk_...). 앞에 sk-를 붙이지 마세요.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4.1-flash
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# DeepSeek V4.1 Flash가 번역 토큰을 추론에 다 쓰지 않도록 끈다.
OPENCODE_REASONING_EFFORT=none

# OpenCode Console(종량제)를 쓸 경우 위 BASE_URL 대신:
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# r/seriea 인기 댓글까지 가져오려면 (Reddit script 앱)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit이 요구하는 고유 UA. /u/닉네임을 넣으면 좋다.
REDDIT_USER_AGENT=seriea-feed/0.2 (personal non-profit Serie A fan feed)

# 경기 결과 자동 갱신 (TheSportsDB). 무료 test key 123, 운영 시 본인 키 권장
THESPORTSDB_API_KEY=123
# FIXTURE_SEASON=2026-2027
